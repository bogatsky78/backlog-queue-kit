diff --git a/src/utils/task-tree.ts b/src/utils/task-tree.ts
new file mode 100644
index 0000000..cf573d5
--- /dev/null
+++ b/src/utils/task-tree.ts
@@ -0,0 +1,68 @@
+import type { Task } from "../types/index.ts";
+import { taskIdsEqual } from "./task-id.ts";
+import { isTerminalStatus } from "./terminal-status.ts";
+
+export interface TaskTreeRow {
+	task: Task;
+	depth: number;
+	/** Direct subtasks present in the same list, i.e. what collapsing this row hides one level down. */
+	childCount: number;
+	completedChildCount: number;
+}
+
+/**
+ * Lays an already filtered and sorted list out as a tree: a subtask goes under its parent only when the
+ * parent is in the list too, otherwise it stays a top-level row rather than disappearing behind a filter.
+ * Siblings keep the order they had in the input, so the list's sort applies on every level.
+ */
+export function buildTaskTree(tasks: readonly Task[], statuses: readonly string[]): TaskTreeRow[] {
+	const parentOf = new Map<Task, Task>();
+	const children = new Map<Task, Task[]>();
+	for (const task of tasks) {
+		if (!task.parentTaskId) continue;
+		const parentId = task.parentTaskId;
+		const parent = tasks.find((candidate) => candidate !== task && taskIdsEqual(parentId, candidate.id));
+		if (!parent) continue;
+		parentOf.set(task, parent);
+		const siblings = children.get(parent);
+		if (siblings) siblings.push(task);
+		else children.set(parent, [task]);
+	}
+
+	const rows: TaskTreeRow[] = [];
+	const visited = new Set<Task>();
+	const visit = (task: Task, depth: number) => {
+		if (visited.has(task)) return;
+		visited.add(task);
+		const direct = children.get(task) ?? [];
+		rows.push({
+			task,
+			depth,
+			childCount: direct.length,
+			completedChildCount: direct.filter((child) => isTerminalStatus(child.status, statuses)).length,
+		});
+		for (const child of direct) visit(child, depth + 1);
+	};
+
+	for (const task of tasks) {
+		if (!parentOf.has(task)) visit(task, 0);
+	}
+	// A parent cycle has no root to start from; show its members flat rather than drop them.
+	for (const task of tasks) visit(task, 0);
+	return rows;
+}
+
+/** Drops the rows that sit below a collapsed row. */
+export function visibleTaskTreeRows(rows: readonly TaskTreeRow[], collapsedIds: ReadonlySet<string>): TaskTreeRow[] {
+	const visible: TaskTreeRow[] = [];
+	let hiddenBelow: number | null = null;
+	for (const row of rows) {
+		if (hiddenBelow !== null) {
+			if (row.depth > hiddenBelow) continue;
+			hiddenBelow = null;
+		}
+		visible.push(row);
+		if (row.childCount > 0 && collapsedIds.has(row.task.id)) hiddenBelow = row.depth;
+	}
+	return visible;
+}
