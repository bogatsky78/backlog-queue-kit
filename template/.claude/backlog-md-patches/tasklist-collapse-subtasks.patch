@@ -0,0 +1,88 @@
+import { describe, expect, it } from "bun:test";
+import type { Task } from "../types/index.ts";
+import { buildTaskTree, visibleTaskTreeRows } from "../utils/task-tree.ts";
+
+const STATUSES = ["To Do", "In Progress", "Done"] as const;
+
+function makeTask(id: string, status: string, parentTaskId?: string): Task {
+	return {
+		id,
+		title: `Task ${id}`,
+		status,
+		assignee: [],
+		createdDate: "2026-10-20",
+		labels: [],
+		dependencies: [],
+		rawContent: "",
+		...(parentTaskId ? { parentTaskId } : {}),
+	} as Task;
+}
+
+const layout = (rows: ReturnType<typeof buildTaskTree>) => rows.map((row) => `${"  ".repeat(row.depth)}${row.task.id}`);
+
+describe("buildTaskTree", () => {
+	it("nests subtasks under their parent across several levels", () => {
+		const tasks = [
+			makeTask("TASK-7.2.2", "To Do", "TASK-7.2"),
+			makeTask("TASK-9", "In Progress"),
+			makeTask("TASK-7.2", "In Progress", "TASK-7"),
+			makeTask("TASK-7", "In Progress"),
+			makeTask("TASK-7.2.1", "Done", "TASK-7.2"),
+		];
+		const rows = buildTaskTree(tasks, STATUSES);
+		expect(layout(rows)).toEqual(["TASK-9", "TASK-7", "  TASK-7.2", "    TASK-7.2.2", "    TASK-7.2.1"]);
+		const frame = rows.find((row) => row.task.id === "TASK-7.2");
+		expect(frame?.childCount).toBe(2);
+		expect(frame?.completedChildCount).toBe(1);
+	});
+
+	it("keeps the input order among siblings", () => {
+		const tasks = [
+			makeTask("TASK-2", "To Do"),
+			makeTask("TASK-2.3", "To Do", "TASK-2"),
+			makeTask("TASK-2.1", "To Do", "TASK-2"),
+			makeTask("TASK-2.2", "To Do", "TASK-2"),
+		];
+		expect(layout(buildTaskTree(tasks, STATUSES))).toEqual(["TASK-2", "  TASK-2.3", "  TASK-2.1", "  TASK-2.2"]);
+	});
+
+	it("keeps a subtask visible when its parent is filtered out", () => {
+		const tasks = [makeTask("TASK-7.2.2", "To Do", "TASK-7.2"), makeTask("TASK-3", "To Do")];
+		const rows = buildTaskTree(tasks, STATUSES);
+		expect(layout(rows)).toEqual(["TASK-7.2.2", "TASK-3"]);
+		expect(rows.every((row) => row.childCount === 0)).toBe(true);
+	});
+
+	it("shows tasks caught in a parent cycle instead of dropping them", () => {
+		const tasks = [makeTask("TASK-1", "To Do", "TASK-2"), makeTask("TASK-2", "To Do", "TASK-1")];
+		expect(buildTaskTree(tasks, STATUSES)).toHaveLength(2);
+	});
+});
+
+describe("visibleTaskTreeRows", () => {
+	const tasks = [
+		makeTask("TASK-7", "In Progress"),
+		makeTask("TASK-7.2", "In Progress", "TASK-7"),
+		makeTask("TASK-7.2.1", "To Do", "TASK-7.2"),
+		makeTask("TASK-7.1", "To Do", "TASK-7"),
+		makeTask("TASK-9", "To Do"),
+	];
+	const rows = buildTaskTree(tasks, STATUSES);
+
+	it("hides every descendant of a collapsed row", () => {
+		expect(layout(visibleTaskTreeRows(rows, new Set(["TASK-7"])))).toEqual(["TASK-7", "TASK-9"]);
+	});
+
+	it("hides only the collapsed branch", () => {
+		expect(layout(visibleTaskTreeRows(rows, new Set(["TASK-7.2"])))).toEqual([
+			"TASK-7",
+			"  TASK-7.2",
+			"  TASK-7.1",
+			"TASK-9",
+		]);
+	});
+
+	it("ignores a collapsed id that has no children in the list", () => {
+		expect(visibleTaskTreeRows(rows, new Set(["TASK-9", "TASK-7.2.1"]))).toHaveLength(5);
+	});
+});
